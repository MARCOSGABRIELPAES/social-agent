# Copie para .env e preencha. O .env esta no .gitignore.
#
# O agente funciona em DOIS modos:
#
#   MODO MANUAL  - nao precisa de nada aqui. Voce exporta um CSV
#                  (do Metricool, do Later ou do template em
#                  dados/modelo_import.csv) e roda:  py importar.py
#
#   MODO AUTO    - preenche os tokens abaixo e o agente puxa tudo
#                  sozinho da API oficial da Meta:  py coletar.py
#
# --- MODO AUTO: Instagram Graph API ---------------------------------------
# Requisitos: as duas contas precisam ser Instagram Profissional
# (Business ou Creator) e estar vinculadas a uma Pagina do Facebook.
# Passo a passo completo em README.md, secao "Ligando o modo automatico".

# Token de acesso de longa duracao (60 dias, renovado sozinho pelo agente).
IG_ACCESS_TOKEN=

# IDs numericos das contas do Instagram. Deixe em branco que o agente
# descobre sozinho pelo token e grava em config/perfis.json.
IG_USER_ID_MARCOSGABRIEL_IA=
IG_USER_ID_BOMBEIRO_IA=

# Versao da API. So mexa se a Meta descontinuar a atual.
IG_API_VERSION=v23.0
